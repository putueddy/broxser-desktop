#!/usr/bin/env python3
"""Owned discovery fixture; --version deliberately never returns."""
import json
import os
from pathlib import Path
import sys
import time

if "--version" in sys.argv:
    time.sleep(60)
    sys.exit(92)

profile = Path(next(arg.split("=", 1)[1] for arg in sys.argv if arg.startswith("--user-data-dir=")))
root = profile.parent
previous_present = False
previous_running = []
previous_file = root / "previous-owner.json"
if previous_file.exists():
    previous = json.loads(previous_file.read_text())
    previous_present = Path(previous["profile"]).exists()
    for identity in previous["processes"]:
        try:
            stat = Path(f"/proc/{identity['pid']}/stat").read_text().rsplit(")", 1)[1].split()
            if stat[0] != "Z" and int(stat[19]) == identity["start_time"]:
                previous_running.append(identity)
        except (FileNotFoundError, ProcessLookupError):
            pass
record = {
    "pid": os.getpid(), "profile": str(profile), "args": sys.argv[1:],
    "previous_profile_present": previous_present, "previous_running": previous_running,
}
with (root / "qa-launches.jsonl").open("a") as output:
    output.write(json.dumps(record) + "\n")
port = (root / "fake-cdp-port").read_text().strip()
(profile / "DevToolsActivePort").write_text(f"{port}\n/devtools/browser/qa-fidelity\n")
time.sleep(60)
